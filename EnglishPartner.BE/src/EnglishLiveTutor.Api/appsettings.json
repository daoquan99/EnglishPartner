{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LingoMint;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;"
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Observability": {
    "TraceSampleRatio": 0.2
  },
  "Jwt": {
    "Issuer": "EnglishLiveTutor.Api",
    "Audience": "EnglishLiveTutor.Client",
    "AccessTokenMinutes": 60,
    "SecretKey": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AuthRefresh": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Ai": {
      "TokenLimit": 20,
      "TokensPerPeriod": 20,
      "ReplenishmentPeriodSeconds": 60
    }
  },
  "Storage": {
    "LessonMedia": {
      "RootPath": "storage/lesson-media",
      "MaxFileSizeBytes": 26214400
    }
  },
  "Ai": {
    "VocabularyGeneration": {
      "TimeoutSeconds": 600
    },
    "GrammarGeneration": {
      "TimeoutSeconds": 600
    },
    "LessonGeneration": {
      "ModelCode": "gemini-3.8-flash",
      "TimeoutSeconds": 600,
      "MaxRetries": 3
    },
    "LessonAssessment": {
      "ModelCode": "gemini-3.8-flash",
      "TimeoutSeconds": 600,
      "MaxRetries": 3
    },
    "LessonRolePlay": {
      "ModelCode": "gemini-3.8-flash",
      "TimeoutSeconds": 600,
      "MaxRetries": 2
    },
    "PronunciationAssessment": {
      "TimeoutSeconds": 600
    },
    "PronunciationTts": {
      "TimeoutSeconds": 600
    },
    "LiveTutor": {
      "TranslationFallbackTimeoutSeconds": 8,
      "GrammarCorrectionTimeoutSeconds": 20,
      "CorrectionModelCode": "gemini-3.8-flash"
    },
    "AntigravityCli": {
      "Enabled": false,
      "ExecutablePath": null,
      "DefaultModel": "gemini-3.8-flash-medium",
      "TimeoutSeconds": 600,
      "AllowedModels": [
        "gemini-3.8-flash-medium",
        "gemini-3.8-flash-low",
        "gemini-3.8-flash-high"
      ]
    }
  },
  "LiveSession": {
    "IdleTimeoutMinutes": 15
  },
  "VocabularyGames": {
    "ExpirationPollSeconds": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Redis": {}
}
