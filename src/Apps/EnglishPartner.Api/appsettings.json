{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=englishpartner;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Quartz": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}    {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "EnglishPartner.Api"
    }
  },
  "GeminiAI": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/models",
    "ModelName": "gemini-3.1-flash-lite-preview",
    "GenerateContentApi": "generateContent",
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "MaxOutputTokens": 8192,
    "Temperature": 0.7,
    "TopP": 0.95,
    "ThinkingLevel": null,
    "DisableAllSafetyRestrictions": true
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "EnglishPartner",
    "Audience": "EnglishPartner.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "SocialAuth": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID"
    },
    "Microsoft": {
      "ClientId": "YOUR_MICROSOFT_CLIENT_ID",
      "TenantId": "common"
    }
  },
  "FileStorage": {
    "BasePath": "./uploads",
    "BaseUrl": "/uploads",
    "MaxFileSizeMB": 10
  },
  "Cache": {
    "InstanceName": "EnglishPartner:"
  },
  "RateLimiting": {
    "AIChat": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AIScoring": {
      "PermitLimit": 50,
      "WindowSeconds": 3600
    }
  },
  "Outbox": {
    "PollingIntervalSeconds": 10,
    "BatchSize": 20
  },
  "Notifications": {
    "EnableAutoCleanup": true,
    "KeepHistoryDays": 30,
    "CleanupIntervalHours": 24
  }
}
