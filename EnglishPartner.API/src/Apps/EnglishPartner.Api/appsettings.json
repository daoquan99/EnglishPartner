{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=englishpartner;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "MediatR": {
    "LicenseKey": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Quartz": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}    {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "EnglishPartner.Api"
    }
  },
  "GeminiAI": {
    "ApiKey": "",
    "LiveApiKey": "",
    "ProjectId": "",
    "Location": "us-central1",
    "ModelName": "gemini-2.5-flash", // "gemini-3-flash-preview", "gemini-3.1-flash-lite-preview"
    "LiveModelName": "models/gemini-3.1-flash-live-preview",
    "VoiceName": "zephyr",
    "MaxOutputTokens": 16384,
    "Temperature": 0.7,
    "TopP": 0.95,
    "ThinkingLevel": null,
    "DisableAllSafetyRestrictions": false,
    "TimeoutSeconds": 300,
    "DefaultTtsVoice": "en-US-Neural2-C",
    "DefaultTtsLanguage": "en-US",
    "DefaultTtsSpeakingRate": 1.0,
    "DefaultGeminiTtsStylePrompt": "Read aloud in a clear, encouraging, and highly professional tone of a native English language teacher.",
    "DefaultGeminiTtsModel": "gemini-3.1-flash-tts",
    "DefaultSttLanguage": "en-US",
    "DefaultChatSystemPrompt": "You are a friendly, encouraging, and highly effective English language tutor.\nYou are chatting with a student whose current English level is: {level}.{topicInstruction}\n\nGuidelines:\n1. Always adjust your vocabulary and grammar complexity to match a {level} student.\n2. If the student makes a mistake, gently correct them, explain why, and encourage them.\n3. Keep your responses concise and engaging (1-3 short paragraphs).\n4. Ask questions to keep the conversation flowing.\n5. Do not write essays or overwhelm the student with too much information at once."
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "EnglishPartner",
    "Audience": "EnglishPartner.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "SocialAuth": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID"
    },
    "Microsoft": {
      "ClientId": "YOUR_MICROSOFT_CLIENT_ID",
      "TenantId": "common"
    }
  },
  "FileStorage": {
    "BasePath": "./uploads",
    "BaseUrl": "/uploads",
    "MaxFileSizeMB": 10
  },
  "Cache": {
    "InstanceName": "EnglishPartner:"
  },
  "RateLimiting": {
    "AIChat": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AIScoring": {
      "PermitLimit": 50,
      "WindowSeconds": 3600
    }
  },
  "Outbox": {
    "PollingIntervalSeconds": 10,
    "BatchSize": 20
  },
  "Notifications": {
    "EnableAutoCleanup": true,
    "KeepHistoryDays": 30,
    "CleanupIntervalHours": 24
  }
}